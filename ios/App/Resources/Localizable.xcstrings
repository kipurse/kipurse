    "Pick a payee and amount. Within Siri's allowance it pays a saved payee; otherwise Kipurse asks for Face ID.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a payee and amount. Within Siri's allowance it pays a saved payee; otherwise Kipurse asks for Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选收款方和金额。在 Siri 的额度内直接付给已保存的收款方；否则 Kipurse 会请你用 Face ID 确认。"
          }
        }
      }
    },
    "How much USDC?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
