        }
      }
    },
    "Siri can only pay saved payees (addresses you've paid before, or your own Base Account). Pay new addresses in Kipurse.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri can only pay saved payees (addresses you've paid before, or your own Base Account). Pay new addresses in Kipurse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能付给已保存的收款方（付过款的地址，或你自己的 Base 账户）。新地址请在 Kipurse 里付。"
          }
        }
      }
    },
    "That amount isn't valid.": {
      "extractionState": "manual",
      "localizations": {
