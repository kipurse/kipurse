    "Open Kipurse and unlock with Face ID once; then you can ask Siri for 12 hours.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Kipurse and unlock with Face ID once; then you can ask Siri for 12 hours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开 Kipurse 用 Face ID 解锁一次，之后 12 小时内可以直接问 Siri。"
          }
        }
      }
    },
    "This iPhone isn't a signer of your Kipurse wallet yet.": {
      "extractionState": "manual",
