    "Pay a saved payee. Within Siri's allowance it pays; over it or a new payee asks for Face ID.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay a saved payee. Within Siri's allowance it pays; over it or a new payee asks for Face ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付给已保存的收款方。在 Siri 的额度内直接付；超额或新收款方会请你用 Face ID 确认。"
          }
        }
      }
    },
