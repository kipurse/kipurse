{
  "name": "@kipurse/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Kipurse agent SDK: connect any agent framework to an owner-controlled Kipurse USDC wallet gateway (parse, preflight, pay exactly once, limits, merchant info).",
  "main": "src/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./adapters/openai-agents": "./examples/adapters/openai-agents.mjs",
    "./adapters/langchain": "./examples/adapters/langchain.mjs",
    "./adapters/claude": "./examples/adapters/claude.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kipurse/kipurse.git",
    "directory": "server/sdk"
  },
  "homepage": "https://github.com/kipurse/kipurse/tree/main/server/sdk",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-agent",
    "usdc",
    "base",
    "x402",
    "mcp",
    "wallet"
  ],
  "sideEffects": false
}
