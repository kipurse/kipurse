pragma solidity ^0.8.28;
import {Test} from "forge-std/Test.sol";
import {KipurseTrustV5} from "../src/KipurseTrustV5.sol";
/// Gateway (src/v5/inline-trust.mjs) <-> Solidity vectors for V5.2 inline trust.
contract KipurseV52VectorsTest is Test {
    function test_structHash_matches_gateway() public {
        KipurseTrustV5 t = new KipurseTrustV5();
        address[] memory payees = new address[](2); payees[0] = address(0x5409); payees[1] = address(0xbeef);
        address[] memory none = new address[](0);
        bytes32 sh = keccak256(abi.encode(t.TRUST_TYPEHASH(), address(0xaa), keccak256("coffee.example"), keccak256(bytes("coffee.example")), uint64(3),
            keccak256(abi.encodePacked(payees)), keccak256(abi.encodePacked(none)), uint160(2e6), uint160(5e6), uint64(1715552000), bytes32(uint256(0x1111111111111111111111111111111111111111111111111111111111111111)), uint256(1715552000)));
        assertEq(sh, 0x1d26f3aa59722689d0a6f3c1d4830657d290be09da8b1101fbc641b41c4cf24f);
    }
    function dec(bytes calldata b) external pure returns (KipurseTrustV5.TrustParams memory t, bytes32 n, uint256 d, bytes memory s) {
        require(bytes4(b[:4]) == 0x4b505452, "tag");
        (t, n, d, s) = abi.decode(b[4:], (KipurseTrustV5.TrustParams, bytes32, uint256, bytes));
    }
    function test_encoding_matches_gateway() public view {
        (KipurseTrustV5.TrustParams memory t, bytes32 n, uint256 d, bytes memory s) = this.dec(hex"");
        assertEq(t.payees[0], address(0x5409)); assertEq(t.single, 2e6); assertEq(t.daily, 5e6); assertEq(t.expiry, 1715552000);
        assertEq(n, bytes32(uint256(0x1111111111111111111111111111111111111111111111111111111111111111))); assertEq(d, 1715552000); assertEq(s, hex"abcd");
        assertEq(keccak256(bytes(t.name)), keccak256("coffee.example"));
    }
}
